# Copy to .env (never commit it). TESTNET ONLY.
QUASARIA_NETWORK=testnet
QUASARIA_RPC_URL=https://soroban-testnet.stellar.org
QUASARIA_VAULT_ID=C...
QUASARIA_ORACLE_ID=C...
# Operator (bot) secret key. Delegate it in the UI (Bots > Delegate bot key):
# the operator can open/close positions but can never withdraw funds.
QUASARIA_SECRET=S...
# Owner account the bot trades for (the G... that delegated the operator)
QUASARIA_OWNER=G...
